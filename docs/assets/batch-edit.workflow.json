{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "批量元数据编辑 · 工作流",
    "subtitle": "从拖拽入库到批量回写落盘的完整链路（batch-page）",
    "output": "batch-edit.html",
    "viewBox": [760, 880]
  },
  "lanes": [
    { "id": "user", "label": "用户操作" },
    { "id": "fe", "label": "前端状态层" },
    { "id": "ipc", "label": "IPC 边界" },
    { "id": "rust", "label": "Rust 内核" },
    { "id": "err", "label": "异常处理", "variant": "exception" },
    { "id": "disk", "label": "磁盘 I/O" }
  ],
  "phases": [
    { "id": "load", "label": "载入", "fromCol": 0, "toCol": 1 },
    { "id": "edit", "label": "编辑与预检", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "write", "label": "批量回写", "fromCol": 4, "toCol": 5, "variant": "dashed" }
  ],
  "groups": [
    { "id": "parse_loop", "label": "逐文件解析", "lane": "rust", "fromCol": 1, "toCol": 2, "variant": "dashed" },
    { "id": "save_loop", "label": "批量事务", "lane": "rust", "fromCol": 4, "toCol": 5, "variant": "emphasis" },
    { "id": "fail_path", "label": "部分失败可继续", "lane": "err", "fromCol": 4, "toCol": 5, "variant": "security" }
  ],
  "mainPath": ["drop", "store", "invoke", "parse", "form", "preview", "batch", "build"],
  "nodes": [
    { "id": "drop", "lane": "user", "col": 0, "type": "external", "label": "拖拽 / 选目录", "sublabel": "FileDropZone" },
    { "id": "form", "lane": "user", "col": 3, "type": "frontend", "label": "字段编辑", "sublabel": "TanStack Form + zod", "tag": "模板可复用" },
    { "id": "report", "lane": "user", "col": 5, "type": "frontend", "label": "结果汇总", "sublabel": "成功 / 失败明细" },

    { "id": "store", "lane": "fe", "col": 1, "type": "frontend", "label": "file-store", "sublabel": "zustand 去重入库" },
    { "id": "preview", "lane": "fe", "col": 4, "type": "frontend", "label": "变更预检", "sublabel": "diff 待写字段" },

    { "id": "scan", "lane": "ipc", "col": 0, "type": "messagebus", "label": "scan_directory", "sublabel": "recursive 枚举" },
    { "id": "invoke", "lane": "ipc", "col": 1, "type": "messagebus", "label": "trackedInvoke", "sublabel": "parse_*_from_path" },
    { "id": "batch", "lane": "ipc", "col": 4, "type": "messagebus", "label": "批量保存命令", "sublabel": "batch_save_*_to_source", "tag": "按扩展名分派" },

    { "id": "parse", "lane": "rust", "col": 2, "type": "backend", "label": "documents::*", "sublabel": "zip + xmltree / lopdf" },
    { "id": "build", "lane": "rust", "col": 5, "type": "backend", "label": "重建文档字节", "sublabel": "重写 core / app.xml" },

    { "id": "invalid", "lane": "err", "col": 4, "type": "security", "label": "解析失败", "sublabel": "标记 status=error" },
    { "id": "collect", "lane": "err", "col": 5, "type": "messagebus", "label": "结果收集", "sublabel": "BatchSaveResultItem" },

    { "id": "read", "lane": "disk", "col": 1, "type": "database", "label": "读取源文件", "sublabel": "fs::read" },
    { "id": "write", "lane": "disk", "col": 5, "type": "database", "label": "原地覆写", "sublabel": "fs::write" }
  ],
  "edges": [
    { "from": "drop", "to": "scan", "label": "目录", "variant": "dashed", "fromSide": "bottom", "toSide": "top", "route": "drop", "labelSegment": 1 },
    { "from": "drop", "to": "store", "variant": "default" },
    { "from": "scan", "to": "store", "label": "文件路径列表", "variant": "dashed", "fromSide": "right", "toSide": "bottom", "labelDy": 18 },
    { "from": "store", "to": "read", "label": "按需读取", "variant": "dashed", "fromSide": "left", "toSide": "left", "route": "return-left", "labelSegment": 1 },
    { "from": "store", "to": "invoke", "label": "解析请求", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop", "labelSegment": 1 },
    { "from": "invoke", "to": "parse", "variant": "default" },
    { "from": "parse", "to": "form", "label": "DocumentMetadata", "variant": "emphasis", "fromSide": "top", "toSide": "bottom", "route": "drop", "labelSegment": 1 },
    { "from": "form", "to": "preview", "variant": "default" },
    { "from": "preview", "to": "batch", "label": "确认写入", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop", "labelSegment": 1 },
    { "from": "batch", "to": "build", "variant": "emphasis" },
    { "from": "build", "to": "write", "variant": "default", "fromSide": "right", "toSide": "right", "route": "outside-right" },
    { "from": "parse", "to": "invalid", "label": "格式不支持", "variant": "security", "role": "error", "fromSide": "bottom", "toSide": "top", "route": "drop", "labelSegment": 1 },
    { "from": "invalid", "to": "collect", "variant": "dashed", "role": "branch" },
    { "from": "collect", "to": "report", "label": "失败明细", "variant": "security", "role": "return", "fromSide": "right", "toSide": "right", "route": "outside-right" },
    { "from": "write", "to": "report", "label": "成功计数", "variant": "emphasis", "role": "return", "fromSide": "left", "toSide": "left", "route": "return-left" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "关键设计",
      "items": [
        "文件句柄始终留在 Rust 侧，前端只传路径",
        "四种格式各有独立命令，按扩展名分派",
        "批量接口返回逐条结果，不因单条失败整体回滚",
        "模板机制让同一套字段覆盖多批文档"
      ]
    },
    {
      "dot": "rose",
      "title": "清除痕迹路径",
      "items": [
        "batch_clear_and_save_* 走同一条批量链路",
        "BatchClearOptions 支持 templateId + 字段覆盖",
        "清除后仍重建合法 OOXML，不破坏文档结构",
        "隐藏信息由 extract_hidden 独立探测"
      ]
    },
    {
      "dot": "emerald",
      "title": "可观测性",
      "items": [
        "每次 invoke 记录命令名、入参、耗时、结果",
        "tauri-plugin-log 输出到 stdout 与日志文件",
        "TanStack Devtools 在开发态观察表单状态",
        "sonner toast 承担用户侧结果反馈"
      ]
    }
  ]
}
