  "cards": [
    {
      "dot": "cyan",
      "title": "渲染进程",
      "items": [
        "pages/ 只做编排，算法下沉到 lib/",
        "lib/ 为纯逻辑，无 JSX，可脱离 React 单测",
        "样式用 CSS Modules 隔离，只用主题变量"
      ]
    },
    {
      "dot": "rose",
      "title": "信任边界",
      "items": [
        "前端无法直接访问文件系统 / 进程 / 网络",
        "所有前端参数在 Rust 侧重新校验",
        "风险定级在主进程完成，前端只做呈现",
        "capability 仅授予必要命令与最窄 scope"
      ]
    },
    {
      "dot": "emerald",
      "title": "领域内核",
      "items": [
        "四种格式映射到统一元数据模型",
        "比对引擎产出线索而非结论",
        "每个能力只有单一实现入口",
        "文档全程留在用户本机，不上传"
      ]
    }
  ]
