    { "id": "result", "type": "database", "label": "CompareResult", "sublabel": "线索 + 差异 + 统计", "stage": 4, "row": 0, "tag": "含免责声明" },
    { "id": "report", "type": "backend", "label": "报告导出", "sublabel": "可复核产物", "stage": 4, "row": 3, "tag": "线索非结论" }
  ],
  "flows": [
    { "from": "files", "to": "align", "label": "待对齐文件", "classification": "元数据", "variant": "emphasis", "fromSide": "right", "toSide": "left", "via": [[184, 157], [184, 214]], "labelAt": [206, 178] },
    { "from": "options", "to": "align", "label": "fuzzyMatchFloor", "classification": "阈值", "variant": "dashed", "fromSide": "right", "toSide": "left", "via": [[222, 385], [222, 214]], "labelAt": [226, 330] },
    { "from": "align", "to": "unmatched", "label": "低于阈值", "classification": "需人工", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "straight", "labelAt": [452, 320] },
    { "from": "align", "to": "diff", "label": "AlignedGroup", "classification": "分组", "variant": "emphasis", "fromSide": "right", "toSide": "left", "via": [[420, 214], [420, 157]], "labelAt": [438, 172] },
    { "from": "align", "to": "rules", "label": "groupOf 映射", "classification": "索引", "variant": "default", "fromSide": "right", "toSide": "left", "via": [[420, 214], [420, 271]], "labelAt": [440, 250] },
    { "from": "stopwords", "to": "rules", "label": "过滤通用值", "classification": "降噪", "variant": "dashed", "fromSide": "top", "toSide": "bottom", "route": "straight", "labelAt": [660, 340] },
    { "from": "rules", "to": "pairs", "label": "RiskFinding", "classification": "加权线索", "variant": "emphasis", "fromSide": "right", "toSide": "left", "via": [[638, 271], [638, 214]], "labelAt": [652, 246] },
    { "from": "pairs", "to": "clamp", "label": "回写等级", "classification": "定级", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "straight", "labelAt": [768, 314] },
    { "from": "diff", "to": "result", "label": "字段差异", "classification": "对比表", "variant": "default", "route": "straight", "labelAt": [852, 144] },
    { "from": "clamp", "to": "result", "label": "CompanyPairRisk", "classification": "风险线索", "variant": "emphasis", "fromSide": "right", "toSide": "bottom", "via": [[878, 328], [878, 212], [960, 212]], "labelAt": [884, 200] },
    { "from": "result", "to": "report", "label": "导出", "classification": "含 disclaimer", "variant": "dashed", "fromSide": "bottom", "toSide": "top", "route": "straight", "labelAt": [1000, 268] }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "对齐策略",
      "items": [
        "三级降级：精确 → 规范化 → 模糊匹配",
        "低于 fuzzyMatchFloor 的文件不强行入组",
        "matchSource 与 matchConfidence 一并输出",
        "宁可不匹配，也不错匹配"
      ]
    },
    {
      "dot": "rose",
      "title": "风险判定",
      "items": [
        "权重体现鉴别力：同一作者 50 分，同软件版本仅 5 分",
        "每条规则设 max_level，弱证据不被强证据带高",
        "停用词过滤 Administrator、Normal.dotm 等通用值",
        "主体对是定级单位，多条线索叠加才构成信号"
      ]
    },
    {
      "dot": "emerald",
      "title": "可复核性",
      "items": [
        "explain 字段记录判定依据，非黑箱结论",
        "refs 保留原始字段值可溯源",
        "排序三级确定，相同输入产出相同结果",
        "disclaimer 随结果下发：线索非结论"
      ]
    }
  ]
}
