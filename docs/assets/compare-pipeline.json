    { "label": "产出" }
  ],
  "nodes": [
    { "id": "files", "type": "external", "label": "CompareFileInput[]", "sublabel": "多主体元数据", "stage": 0, "row": 0, "tag": "含痕迹字段" },
    { "id": "options", "type": "security", "label": "CompareOptions", "sublabel": "阈值 + 规则覆盖", "stage": 0, "row": 4, "tag": "可调参" },

    { "id": "align", "type": "backend", "label": "align", "sublabel": "精确 → 规范化 → 模糊", "stage": 1, "row": 1, "tag": "三级降级" },
    { "id": "unmatched", "type": "external", "label": "Unmatched", "sublabel": "落选并附原因", "stage": 1, "row": 4, "tag": "交人工" },

    { "id": "diff", "type": "backend", "label": "diff", "sublabel": "组内逐字段差分", "stage": 2, "row": 0, "tag": "DiffState" },
    { "id": "rules", "type": "security", "label": "rules", "sublabel": "8 条规则判定", "stage": 2, "row": 2, "tag": "加权命中" },
    { "id": "stopwords", "type": "database", "label": "停用词", "sublabel": "通用值降噪", "stage": 2, "row": 4, "tag": "防误报" },

    { "id": "pairs", "type": "backend", "label": "主体对聚合", "sublabel": "累加分 → 定级", "stage": 3, "row": 1, "tag": "定级单位" },
