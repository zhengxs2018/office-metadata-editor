{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "跨公司文档比对内核 · 数据流",
    "subtitle": "compare_metadata 调用链：归一化 → 对齐 → 字段差异 → 风险规则 → 证据链输出",
    "output": "compare-pipeline.html",
    "viewBox": [1080, 760]
  },
  "stages": [
    { "label": "输入归一" },
    { "label": "文档对齐" },
    { "label": "字段差异" },
    { "label": "风险规则" },
    { "label": "结果消费" }
  ],
  "nodes": [
    { "id": "docs", "type": "frontend", "label": "CompareFileInput", "sublabel": "companyId + metadata", "stage": 0, "row": 1, "tag": "前端组装" },
    { "id": "hiddenx", "type": "backend", "label": "extract_hidden", "sublabel": "批注 / 修订 / XMP", "stage": 0, "row": 3, "tag": "回填" },

    { "id": "norm", "type": "backend", "label": "normalize", "sublabel": "全半角 · 停用词 · pinyin", "stage": 1, "row": 0, "tag": "306 行" },
    { "id": "alignf", "type": "backend", "label": "align_files", "sublabel": "精确 → 模糊 → 兜底", "stage": 1, "row": 2, "tag": "阈值可调" },
    { "id": "unmatched", "type": "database", "label": "unmatched", "sublabel": "待人工复核", "stage": 1, "row": 4 },

    { "id": "spec", "type": "database", "label": "fields::spec", "sublabel": "字段字典 + Tier", "stage": 2, "row": 0, "tag": "Risk / Info" },
    { "id": "diffg", "type": "backend", "label": "diff_group", "sublabel": "逐字段两两比对", "stage": 2, "row": 2 },
    { "id": "groups", "type": "database", "label": "AlignedGroup", "sublabel": "cells + confidence", "stage": 2, "row": 4, "tag": "gNNNN" },

    { "id": "eval", "type": "security", "label": "rules::evaluate", "sublabel": "同作者 / 时间邻近", "stage": 3, "row": 1, "tag": "627 行" },
    { "id": "finding", "type": "database", "label": "Finding", "sublabel": "证据链 + groupId", "stage": 3, "row": 3 },

    { "id": "result", "type": "messagebus", "label": "CompareResult", "sublabel": "schemaVersion + stats", "stage": 4, "row": 0, "tag": "camelCase" },
    { "id": "workbench", "type": "frontend", "label": "对比工作台", "sublabel": "selectors.ts 纯函数", "stage": 4, "row": 2 },
    { "id": "xlsxout", "type": "cloud", "label": "Excel 报告", "sublabel": "SheetJS 导出", "stage": 4, "row": 4, "tag": "落盘" }
  ],
  "flows": [
    { "from": "docs", "to": "norm", "label": "原始元数据", "classification": "文档属性", "variant": "emphasis" },
    { "from": "hiddenx", "to": "norm", "label": "隐藏痕迹", "classification": "作者线索", "variant": "security" },
    { "from": "norm", "to": "alignf", "label": "归一化键", "classification": "文件名", "variant": "emphasis" },
    { "from": "alignf", "to": "unmatched", "label": "低于阈值", "classification": "未归组", "variant": "dashed" },
    { "from": "alignf", "to": "diffg", "label": "同组文档", "classification": "跨公司配对", "variant": "emphasis" },
    { "from": "alignf", "to": "groups", "label": "分组结构", "classification": "对齐矩阵", "variant": "default" },
    { "from": "spec", "to": "diffg", "label": "字段元信息", "classification": "比对配置", "variant": "dashed" },
    { "from": "diffg", "to": "eval", "label": "DiffState", "classification": "差异事实", "variant": "emphasis" },
    { "from": "norm", "to": "eval", "label": "归一化作者", "classification": "规则输入", "variant": "dashed" },
    { "from": "eval", "to": "finding", "label": "命中规则", "classification": "风险线索", "variant": "security" },
    { "from": "eval", "to": "result", "label": "PairRisk 等级", "classification": "高 / 中 / 低", "variant": "emphasis" },
    { "from": "finding", "to": "result", "label": "证据聚合", "classification": "按组回填", "variant": "default" },
    { "from": "groups", "to": "workbench", "label": "对齐矩阵", "classification": "只读视图", "variant": "default", "labelAt": [745, 566] },
    { "from": "result", "to": "workbench", "label": "渲染数据", "classification": "IPC 返回", "variant": "emphasis" },
    { "from": "workbench", "to": "xlsxout", "label": "导出请求", "classification": "write_binary_file", "variant": "dashed" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "对齐策略 (align.rs)",
      "items": [
        "同公司文件不互比，只做跨公司对齐",
        "先精确匹配归一化文件名，再走模糊相似度",
        "match_confidence 保留三位小数供前端展示",
        "低于 fuzzyMatchFloor 的进入 unmatched 清单"
      ]
    },
    {
      "dot": "rose",
      "title": "风险信号 (rules.rs)",
      "items": [
        "跨公司文档共享作者或最后修改者",
        "创建、修改时间高度邻近",
        "残留批注作者、修订作者、XMP creators",
        "模板 ID 或 application 指纹一致"
      ]
    },
    {
      "dot": "emerald",
      "title": "契约稳定性",
      "items": [
        "SCHEMA_VERSION 固定在 model.rs，前后端共识",
        "DISCLAIMER 随结果下发，强调仅供人工复核",
        "serde camelCase 直接对齐 TS 类型定义",
        "TS 侧 selectors.ts 为纯函数，不改变内核语义"
      ]
    }
  ]
}
